# MTK project .rc configure

import init.mt6755.usb.rc

on init
    mkdir /mnt/media_rw/usbotg 0700 media_rw media_rw
    mkdir /storage/usbotg 0700 root root

    # MTK Wi-Fi/BT bring-up expects stock legacy STP/WMT char nodes even
    # when ueventd misses them on this rebase kernel.
    mknod /dev/stpwmt c 190 0 0660 system system
    chmod 0660 /dev/stpwmt
    chown system system /dev/stpwmt
    restorecon /dev/stpwmt

    mknod /dev/stpbt c 192 0 0660 bluetooth bluetooth
    chmod 0660 /dev/stpbt
    chown bluetooth bluetooth /dev/stpbt
    restorecon /dev/stpbt

    mknod /dev/wmtWifi c 153 0 0660 system system
    chmod 0660 /dev/wmtWifi
    chown system system /dev/wmtWifi
    restorecon /dev/wmtWifi

    # The rebase kernel exposes Goodix as goodix_fp_spi; the legacy HAL still
    # opens /dev/goodix_fp. Create the HAL path early, before fingerprintd
    # races the post-boot recovery script.
    symlink /dev/goodix_fp_spi /dev/goodix_fp

#Camera
    chmod 0660 /dev/MAINAF
    chown system camera /dev/MAINAF

    chmod 0660 /dev/MAINAF2
    chown system camera /dev/MAINAF2

    chmod 0660 /dev/SUBAF
    chown system camera /dev/SUBAF

    chmod 0660 /dev/GAF001AF
    chown system camera /dev/GAF001AF

    chmod 0660 /dev/DW9714AF
    chown system camera /dev/DW9714AF

    chmod 0660 /dev/stmvl6180
    chown system camera /dev/stmvl6180

    chmod 0660 /dev/GT9762AF
    chown system camera /dev/GT9762AF

    chmod 0660 /dev/gt24c64a_qtech
    chown system camera /dev/gt24c64a_qtech

    chmod 0660 /dev/gt24c64a_ofilm
    chown system camera /dev/gt24c64a_ofilm

    chmod 0660 /dev/s5k5e8_eeprom
    chown system camera /dev/s5k5e8_eeprom

    chmod 0660 /dev/LC898212AF
    chown system camera /dev/LC898212AF

    chmod 0660 /dev/BU64745GWZAF
    chown system camera /dev/BU64745GWZAF

#SMB
    chown system system /proc/smb/ScreenComm
    chmod 0660 /proc/smb/ScreenComm




#Define device for ATCID
    chmod 660 /dev/ttyGS0
    chown system /dev/ttyGS0
    chmod 660 /dev/ttyGS1
    chown system /dev/ttyGS1




    chmod 0660 /dev/spm
    chown system system /dev/spm


on init
    # Refer to http://source.android.com/devices/tech/storage/index.html
    # It said, "Starting in Android 4.4, multiple external storage devices are surfaced to developers through
    #           Context.getExternalFilesDirs(), Context.getExternalCacheDirs(), and Context.getObbDirs().
    #           External storage devices surfaced through these APIs must be a semi-permanent part of the device (such as an SD card slot in a battery compartment).
    #           Developers expect data stored in these locations to be available over long periods of time."
    # Therefore, if the target doesn't support sd hot-plugging (Ex: the SD card slot in a battery compartment), we need to export SECONDARY_STORAGE in 'boot' section
    #
    # export SECONDARY_STORAGE /storage/sdcard1

service fuse_usbotg /system/bin/true
    class late_start
    disabled


service atci_service /vendor/bin/atci_service
	socket atci-service stream 660 radio system
	socket atci-serv-fw stream 660 radio system
	user root
        disabled
	group radio system
service atcid-daemon-u /vendor/bin/atcid
	user system
	group radio system media
	disabled
	oneshot

service atcid-daemon-e /vendor/bin/atcid
	user root
	group radio system
	disabled
	oneshot

on early_property:ro.build.type=eng
    start atci_service
    start atcid-daemon-e
service audio-daemon /vendor/bin/audiocmdservice_atci
    class main
    socket atci-audio stream 660 media system
    user media
    group nvram media system sdcard_rw
    disabled
    oneshot






service spm_script /vendor/bin/spm_loader
    user system
    group system
    class core
    oneshot

# goodix fingerprint
# NOTE: services 'goodixfpd' and 'fingerprintd' plus the on-fs chown/chmod
# for /dev/goodix_fp were consolidated into rootdir/init.rc to stop init
# from logging "ignored duplicate definition" at boot.  2026-07-31 (lane
# fingerprint): that consolidation parked them in a file that is NOT
# installed (rootdir/init.rc has no PRODUCT_COPY_FILES entry); goodixfpd now
# lives in rootdir/goodixfpd.rc -> /system/etc/init/goodixfpd.rc, and
# fingerprintd is gone from AOSP P entirely.  Keep the post-boot trigger
# below: m681pboot is diagnostics, not fingerprint recovery.
on property:sys.boot_completed=1
    write /sys/class/leds/lcd-backlight/brightness 128
    write /sys/devices/platform/leds-mt65xx/leds/lcd-backlight/brightness 128
    start m681pboot
# goodix fingerprint end

on property:init.svc.surfaceflinger=running
    write /sys/class/leds/lcd-backlight/brightness 128
    write /sys/devices/platform/leds-mt65xx/leds/lcd-backlight/brightness 128

service m681pboot /system/bin/sh /system/bin/m681_postboot_recover.sh
    class late_start
    user root
    group root system
    seclabel u:r:init:s0
    disabled
    oneshot

on boot
    # The original file had these as top-level commands, which this init rejects.
    chown system system /sys/srs/srs_enable
    chmod 0660 /sys/srs/srs_enable
    chown system system /sys/srs/srs_debug
    chmod 0660 /sys/srs/srs_debug
    chown system system /sys/srs/srs_cpulevel
    chmod 0660 /sys/srs/srs_cpulevel
    chown system system /sys/srs/srs_gpulevel
    chmod 0660 /sys/srs/srs_gpulevel
    chown system system /sys/srs/srs_buslevel
    chmod 0660 /sys/srs/srs_buslevel
    chown system system /sys/srs/srs_iolevel
    chmod 0660 /sys/srs/srs_iolevel
    chown system system /sys/srs/srs_memlevel
    chmod 0660 /sys/srs/srs_memlevel

# Build Station: MTK adb peripheral mode
on property:sys.usb.config=adb && property:sys.usb.configfs=0
    write /sys/devices/platform/mt_usb/cmode 1
    write /dev/kmsg "Build Station USB: adb cmode=1"

on property:sys.usb.config=adb
    write /sys/devices/platform/mt_usb/cmode 1
