#
# IMPORTANT: Do not create world writable files or directories.
# This is a common source of Android security bugs.
#

on early-init
    write /sys/class/net/ccmni0/queues/rx-0/rps_cpus "ff"
    write /sys/class/net/ccmni1/queues/rx-0/rps_cpus "ff"
    write /sys/class/net/ccmni2/queues/rx-0/rps_cpus "ff"
    write /sys/class/net/ccmni0/queues/rx-0/rps_flow_cnt "1000"
    write /sys/class/net/ccmni1/queues/rx-0/rps_flow_cnt "1000"
    write /sys/class/net/ccmni2/queues/rx-0/rps_flow_cnt "1000"
    setprop net.perf.rps ff
    setprop net.perf.cpu.core 4,4,0,0
    setprop net.perf.cpu.freq 1144000,1144000,0,0

on post-fs-data

    write /proc/bootprof "post-fs-data: on modem start"

    # Modem related device nodes
    mkdir /data/nvram/md  0770 root system
    mkdir /data/nvram/md3  0770 root system
    mkdir /data/md3	0770 root system
#  Build-in Modified - S
#    insmod /vendor/lib/modules/ccci_plat.ko
#    insmod /vendor/lib/modules/ccci.ko
#  Build-in Modified - E
#   chown radio radio /sys/class/BOOT/BOOT/boot/md
    chown radio radio /sys/kernel/ccci/boot
    chown system system /sys/kernel/ccci/mdsys1/md_rxd

#SeLinux
    mkdir /data/ccci_cfg 0770 system radio
    restorecon /data/ccci_cfg
    restorecon_recursive /protect_f
    restorecon_recursive /protect_s
    mkdir /dev/radio 0770 radio radio
    chown radio radio /dev/radio
    chmod 0770 /dev/radio
    # This gsm0710muxd blob ignores -s when ccci_get_node_name() fails and
    # falls back to /dev/ttyUSB1. Keep the real MD1 TTY available there.
    symlink /dev/ttyC0 /dev/ttyUSB1
    chown radio radio /dev/ttyC0
    chmod 0660 /dev/ttyC0
    
    # Encrypt phone function
    setprop vold.post_fs_data_done 1

service gsm0710muxd /vendor/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    class core
    user root
    group radio cache inet misc
    disabled
    oneshot

service gsm0710muxdmd2 /vendor/bin/gsm0710muxdmd2 -s /dev/ccci2_tty0 -f 512 -n 8 -m basic
    class core
    user root
    group radio cache inet misc
    disabled
    oneshot
    
service muxreport-daemon /vendor/bin/muxreport
    class core
    user radio
    group radio cache inet misc
    disabled
    oneshot

# Direct fallback for framework sockets. Keep the ccci-managed
# ril-daemon-mtk service on mrild* because mtkrild asks init for mrild.
service ril-mtk-direct /vendor/bin/mtkrild
    class core
    socket rild stream 660 root radio
    socket rild2 stream 660 root radio
    socket rild3 stream 660 root radio
    socket rild4 stream 660 root radio
    socket rild-ims stream 660 root radio
    socket rild-debug stream 660 radio system
    socket rild-oem stream 660 radio system
    socket rild-mtk-ut stream 660 radio net_bt
    socket rild-mtk-ut-2 stream 660 radio net_bt
    socket rild-mtk-modem stream 660 radio system
    socket rild-atci stream 660 root radio
    socket rild-mal stream 660 radio system
    socket rild-mal-at stream 660 radio system
    socket rild-vsim stream 660 root radio
    socket rild-mbim stream 660 root radio
    socket sap_uim_socket1 stream 660 bluetooth bluetooth
    socket sap_uim_socket2 stream 660 bluetooth bluetooth
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

# 2026-07-27: the blanket "kill ril-daemon on sight" guard is GONE. It was
# written when ril-daemon meant the generic AOSP rild (installed by
# hardware/ril/rild/rild.legacy.rc, class main, no `disabled`), which indeed
# could not drive this modem. With ENABLE_VENDOR_RIL_SERVICE the AOSP rild is
# not built at all: ril-daemon is now the MTK Oreo HIDL rild
# (vendor/mediatek/ril), which is the ONLY binary on this device that can
# publish android.hardware.radio@1.0::IRadio. FACT: mtkrild, librilmtk.so,
# mtk-ril.so and rilproxy contain zero "android.hardware.radio" strings and no
# hidl/hwbinder DT_NEEDED, so the socket stack can never register IRadio and
# the framework waits on it forever. Killing ril-daemon here would kill
# telephony. It is `disabled` in rild.rc, so it only ever starts from the
# debug.m681.ril.stack=hidl trigger below.

on property:sys.boot_completed=1
    # Do not restore the old early boot modem autostart: that path hit CCCI/EMI
    # crashes before Android was usable. Start only the primary MD1 stack after
    # framework boot; C2K/VIA stays gated for separate testing.
    setprop persist.radio.reset_on_switch false
    setprop debug.m681.modem.start 1

service ril-daemon-md2 /vendor/bin/mtkrildmd2
    class core
    socket rild-md2 stream 660 root radio
    socket rild2-md2 stream 660 root radio
    socket rild-debug-md2 stream 660 radio system
    socket rild-oem-md2 stream 660 radio system
    socket rild-mtk-ut-md2 stream 660 radio net_bt
    socket rild-mtk-ut-2-md2 stream 660 radio net_bt
    socket rild-mtk-modem-md2 stream 660 radio system
    socket rild-atci-md2 stream 660 root radio
    socket rild-mal-md2 stream 660 radio system
    socket rild-mal-at-md2 stream 660 radio system
    socket rild-vsim-md2 stream 660 root radio
    socket rild-mbim-md2 stream 660 root radio
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

service md_minilog_util /vendor/bin/md_minilog_util
    user radio
    disabled
    oneshot

service mdlogger /vendor/bin/mdlogger
    class main
    user shell
    group shell system radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger1 /vendor/bin/emdlogger1
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger2 /vendor/bin/emdlogger2
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger3 /vendor/bin/emdlogger3
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

service emdlogger5 /vendor/bin/emdlogger5
    class main
    user shell
    group system shell radio sdcard_rw inet sdcard_r media_rw
    disabled
    oneshot

#VIA RILD service
service viarild /vendor/bin/viarild -l /vendor/lib/libviatelecom-withuim-ril.so -- -d /dev/ttySDIO4
    class core
    socket rild-via stream 660 radio radio
    socket msap_c2k_socket1 stream 660 radio radio
    socket msap_c2k_socket2 stream 660 radio radio
    socket msap_c2k_socket3 stream 660 radio radio
    socket msap_c2k_socket4 stream 660 radio radio
    socket rpc stream 660 radio system
    socket rild-debug stream 660 radio system
    socket rild-ctclient stream 660 radio system
    socket rild-atci-c2k stream 660 radio system
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

#
#  Modem related services (Begin)
#

service permission_check /vendor/bin/permission_check
    class main
    user root
    group system radio
    disabled
    oneshot

service ccci_fsd /vendor/bin/ccci_fsd 0
    user radio
    group radio system
    class core
    disabled
    oneshot

service ccci_mdinit /vendor/bin/ccci_mdinit 0
    user system
    group radio system
    class core
    disabled
    oneshot

service ccci3_fsd /vendor/bin/ccci_fsd 2
    user radio
    group  radio system
    class core
    disabled
    oneshot

service ccci3_mdinit /vendor/bin/ccci_mdinit 2
    user system
    group radio system
    class core
    disabled
    oneshot

service ccci_rpcd /vendor/bin/ccci_rpcd 0
    user radio
    group radio system
    class core
    disabled
    oneshot

service pppd_gprs /system/bin/pppd_dt /dev/ttyACM0 debug noauth refuse-eap usepeerdns nodetach
    user root
    group radio cache inet misc
    disabled
    oneshot

#Add by T.Zh for ppp daemon
service pppd /system/bin/pppd file /data/misc/ppp/ppp_options
    user root
    disabled 
    oneshot

#
#
#  Modem related services (End)
#

#Add by hp.chen for 
#
#   Telephony Early Read service
#
service terservice /vendor/bin/terservice
    class core
    user radio
    group radio cache inet misc
    disabled
    oneshot

on property:debug.m681.modem.start=1
    write /proc/bootprof "manual modem start: debug.m681.modem.start"
    # Bring up only the primary MD1 path here; the VIA/C2K flashless path is
    # gated separately because it can reboot the device when /dev/vmodem is
    # not ready. (The old `stop ril-daemon` here is removed for the same reason
    # as the guard above: ril-daemon is now the MTK HIDL rild we WANT.)
    setprop debug.m681.modem.pending 1
    setprop debug.m681.mdtype.ready 0
    setprop persist.radio.reset_on_switch false
    exec - root root -- /system/bin/sh /system/bin/m681_mdtype_fix.sh

on property:debug.m681.mdtype.ready=1 && property:debug.m681.modem.pending=1
    write /proc/bootprof "manual modem start: mdtype verified"
    setprop debug.m681.modem.pending 0
    setprop ril.active.md 12
    start permission_check
    start ccci_fsd
    start ccci_mdinit
    start terservice
    chown radio radio /dev/ccci*
    chmod 0660 /dev/ccci*
    chown radio radio /dev/ttyC*
    chmod 0660 /dev/ttyC*
    symlink /dev/ttyC0 /dev/ttyUSB1
    chown radio radio /dev/ttyC0
    chmod 0660 /dev/ttyC0
    start gsm0710muxd
    setprop debug.m681.ril.stack pending_proxy

on property:debug.m681.ril.stack=direct
    write /proc/bootprof "ril stack: direct ril-mtk-direct public sockets"
    stop ril-proxy
    stop ril-daemon
    stop ril-daemon-mtk-stock
    setprop ril.rilproxy 0
    setprop ril.active.md 12
    start ril-mtk-direct

on property:mtk.md1.status=ready
    write /proc/bootprof "ril stack: md1 ready -> mtk hidl rild"
    # 2026-07-27: default stack switched from stock_proxy to hidl. The stock
    # rilproxy bridge (rilproxy owns rild*, mtkrild owns mrild*) is a
    # pre-Treble SOCKET path with no IRadio, so Android 9 telephony could never
    # attach to it. Rollback: setprop debug.m681.ril.stack stock_proxy (that
    # path is kept intact below), or revert this file.
    stop ril-mtk-direct
    stop ril-proxy
    setprop ril.active.md 12
    setprop debug.m681.ril.stack hidl

# 2026-07-27: MTK Oreo HIDL rild (vendor/mediatek/ril, built because
# ENABLE_VENDOR_RIL_SERVICE + BOARD_PROVIDES_LIBRIL are set in device.mk /
# BoardConfig.mk). Its libril links android.hardware.radio@1.0 AND the vendor
# blobs librilmtk + mtk-ril directly, so RIL_Env is MTK's native 6-slot layout
# (+24 RequestProxyTimedCallback, +32 QueryMyChannelId, +40
# QueryMyProxyIdByThread) rather than AOSP's 4-slot one. That is the same
# widening the 15.1-lane ril_env_shim.c implemented by hand; here it comes from
# vendor/mediatek/include/telephony/ril.h via TARGET_SPECIFIC_HEADER_PATH, so
# no shim is carried.
# rilproxy is deliberately NOT started: the framework talks HIDL to rild
# directly, and ril.rilproxy=0 keeps the socket bridge out of the path.
# ril-daemon and ril-daemon-mtk are now the SAME binary (see init.rilproxy.rc),
# so stop the muxd-promotion alias before starting ours — otherwise a muxd
# promotion that already fired would leave two rilds racing to register IRadio.
# Both are `disabled`, so neither autostarts; exactly one runs at a time.
on property:debug.m681.ril.stack=hidl
    write /proc/bootprof "ril stack: mtk hidl rild"
    stop ril-mtk-direct
    stop ril-daemon-mtk
    stop ril-daemon-mtk-stock
    stop ril-proxy
    setprop ril.rilproxy 0
    setprop ril.active.md 12
    start ril-daemon

# ROLLBACK PATH — kept intact and reachable with
# `setprop debug.m681.ril.stack stock_proxy`. This is the pre-2026-07-27
# default. It cannot serve IRadio (see the hidl block above), so telephony will
# not work on it; it exists to get back to a known state if the HIDL rild
# regresses something. NOTE: it now starts ril-daemon-mtk-stock, because the
# name ril-daemon-mtk was retargeted at the HIDL rild to defuse the
# gsm0710muxd promotion (see init.rilproxy.rc). A muxd promotion while in this
# mode will therefore still start the HIDL rild; a full stock rollback needs
# init.rilproxy.rc reverted too.
on property:debug.m681.ril.stack=stock_proxy
    write /proc/bootprof "ril stack: stock rilproxy bridge (rollback, no IRadio)"
    stop ril-daemon
    stop ril-mtk-direct
    stop ril-daemon-mtk-stock
    stop ril-proxy
    setprop ril.active.md 12
    start ril-daemon-mtk-stock
    setprop ril.rilproxy 1
    start ril-proxy

on property:debug.m681.ril.stack=proxy
    write /proc/bootprof "ril stack: proxy alias to stock bridge"
    setprop debug.m681.ril.stack stock_proxy

on property:init.svc.ril-proxy=stopped && property:debug.m681.ril.fallback=1
    write /proc/bootprof "ril stack: manual fallback direct mtkrild"
    setprop debug.m681.ril.stack direct

on property:debug.m681.c2k.start=1
    write /proc/bootprof "manual c2k start: debug.m681.c2k.start"
    start ccci3_fsd
    start ccci3_mdinit
    start gsm0710muxdmd2
    start ril-daemon-md2

on property:ril.muxreport=1
    start muxreport-daemon
