#
# Rilproxy related services (Begin)
#

#
# Rilproxy used to control ril request/urc/response for gsm rild and c2k rild
#
# brawl11: direct mtkrild cannot own framework rild* sockets because the stock
# binary asks init for mrild*. Keep the stock bridge: rilproxy owns rild*, and
# mtkrild owns mrild* behind it.
service ril-proxy /vendor/bin/rilproxy -l mtk-rilproxy.so
    class core
    socket rild stream 660 root radio
    socket rild2 stream 660 root radio
    socket rild3 stream 660 root radio
    socket rild4 stream 660 root radio
    socket rilproxy-atci stream 660 root radio
    socket rilproxy-ims stream 660 root radio
    socket rilproxy-mal stream 660 radio system
    socket sap_uim_socket1 stream 660 bluetooth bluetooth
    socket sap_uim_socket2 stream 660 bluetooth bluetooth
    socket sap_uim_socket3 stream 660 bluetooth bluetooth
    socket sap_uim_socket4 stream 660 bluetooth bluetooth
    socket embmsd stream 660 radio inet
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    oneshot
    disabled

# 2026-07-27: ril-daemon-mtk is RETARGETED at the MTK HIDL rild.
#
# Why: device FACT (prior art, docs/net2_connectivity/init.modem.rc.net2.diff)
# — once the MUX is up, gsm0710muxd unconditionally issues
#     property_set ctl.stop  ril-daemon
#     property_set ctl.start ril-daemon-mtk
# so leaving this name pointed at /vendor/bin/mtkrild lets muxd tear down the
# working HIDL rild and replace it with the socket daemon that has no IRadio.
# Pointing both names at the same binary makes the promotion a no-op instead of
# a downgrade, and keeps exactly one rild alive (muxd's ctl.stop precedes its
# ctl.start). This is the same redirect the 15.1 lane device-proved.
#
# The stock socket daemon is preserved verbatim below as ril-daemon-mtk-stock
# for the debug.m681.ril.stack=stock_proxy rollback path.
service ril-daemon-mtk /vendor/bin/hw/rild
    class core
    user root
    group radio cache inet misc audio log readproc wakelock system
    disabled
    oneshot

service ril-daemon-mtk-stock /vendor/bin/mtkrild
    class core
    socket mrild stream 660 root radio
    socket mrild2 stream 660 root radio
    socket mrild3 stream 660 root radio
    socket mrild4 stream 660 root radio
    socket rild-ims stream 660 root radio
    socket rild-debug stream 660 radio system
    socket rild-oem stream 660 radio system
    socket rild-mtk-ut stream 660 radio net_bt
    socket rild-mtk-ut-2 stream 660 radio net_bt
    socket rild-mtk-modem stream 660 radio system
    socket rild-atci stream 660 root radio
    socket rild-mal stream 660 radio system
    socket rild-mal-at stream 660 radio system
    socket rild-vsim stream 660 root radio
    socket rild-mbim stream 660 root radio
    socket msap_uim_socket1 stream 660 radio radio
    socket msap_uim_socket2 stream 660 radio radio
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

on property:debug.m681.ril.stack=proxy
    start ril-proxy

on property:debug.m681.ril.stack=stock_proxy
    start ril-proxy


#
# Rilproxy related services (End)
#
