# Android 11 HIDL registration, matching external/wpa_supplicant_8/
# wpa_supplicant/hidl/1.3/android.hardware.wifi.supplicant-service.rc.
# Service paths and board-specific p2p arguments are retained from the device.

on post-fs-data
    # Control sockets (-O below) and the conf the HIDL HAL creates from the
    # template (hidl/1.3/supplicant.cpp).  hostapd.android.rc creates only
    # /data/vendor/wifi and .../hostapd; nothing creates the wpa path.
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    interface android.hardware.wifi.supplicant@1.3::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    group system wifi inet
    disabled
    oneshot
